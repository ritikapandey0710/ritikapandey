# Database connection
DATABASE_URL="postgres://postgres:postgres@localhost:5432/test"
AUTH_SECRET="some-secret"
PORT=3001

# Gemini AI configuration (used by /api/ai/polish and /api/ai/summarize)
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# Email configuration for IMAP (to receive emails and create tickets)
# Uncomment and configure these to enable email-to-ticket functionality
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_IMAP_PORT=993
# EMAIL_IMAP_USER=your-email@gmail.com
# EMAIL_IMAP_PASS=your-app-password
# EMAIL_IMAP_TLS=true
# EMAIL_IMAP_AUTH_TIMEOUT=5000

# Email configuration for SMTP (to send auto-responses)
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=your-email@gmail.com
# EMAIL_SMTP_PASS=your-app-password
# EMAIL_SMTP_TLS=true
# EMAIL_FROM=no-reply@yourdomain.com

# Email polling interval in milliseconds (default: 300000 = 5 minutes)
EMAIL_POLL_INTERVAL=300000

# Webhook secret for HMAC-SHA256 signature verification of incoming webhook
# requests. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# External systems must sign the request body with this secret and send the
# signature in the "x-webhook-signature" header (format: sha256=<hex_digest>).
WEBHOOK_SECRET="your-webhook-secret-here"

# ---------------------------------------------------------------------------
# Sentry error monitoring (optional — server runs normally without it)
# ---------------------------------------------------------------------------
# Create a project at https://sentry.io and copy its DSN here.
SENTRY_DSN=""
# Environment label shown in Sentry ("development" or "production").
SENTRY_ENVIRONMENT="development"
# Optional: only needed for uploading client source maps during production
# builds (see CLAUDE.md). NEVER commit the real token.
# SENTRY_AUTH_TOKEN="your-sentry-auth-token"
# SENTRY_ORG="your-sentry-org-slug"
# SENTRY_PROJECT="your-sentry-project-slug"
