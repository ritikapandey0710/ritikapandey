# Sentry error monitoring (optional — client runs normally without it)
# DSN of your browser JavaScript Sentry project.
VITE_SENTRY_DSN=your-sentry-dsn-here

# Environment label shown in Sentry ("development" or "production");
# falls back to the Vite mode when omitted.
VITE_SENTRY_ENVIRONMENT=development

# Server-side Sentry DSN lives in the root / server .env — see SENTRY_DSN there.