# Environment variables
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/helpdesk?schema=public"
# For development
AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3001"
PORT=3001
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password-here

# Resend API key for sending outgoing emails
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key-here

# Default sender email address for outgoing emails
# If not set, defaults to "Help Desk <onboarding@resend.dev>"
EMAIL_FROM="Help Desk <onboarding@resend.dev>"

# IMAP settings for incoming email (email-to-ticket flow)
# Used by EmailService to poll the inbox and create Help Desk tickets.
# For Gmail, use an App Password (not your normal Gmail password):
#   https://support.google.com/accounts/answer/185833
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=your-imap-user-here
EMAIL_IMAP_PASS=your-imap-pass-here
# Optional: EMAIL_IMAP_TLS=true (defaults to true)
# Optional: EMAIL_IMAP_AUTH_TIMEOUT=5000 (defaults to 5000)
# Optional: EMAIL_POLL_INTERVAL=300000 (defaults to 300000 ms / 5 min)
# Sentry error monitoring (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=