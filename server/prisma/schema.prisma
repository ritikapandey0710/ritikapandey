generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                             String    @id @default(uuid())
  name                           String?
  email                          String    @unique
  emailVerified                  Boolean   @default(false)
  image                          String?
  role                           Role      @default(USER)
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt
  deletedAt                      DateTime?
  Ticket_Ticket_assigneeIdTouser Ticket[]  @relation("Ticket_assigneeIdTouser")
  Ticket_Ticket_reporterIdTouser Ticket[]  @relation("Ticket_reporterIdTouser")
  TicketReply_authorIdToReply    Reply[]   @relation("TicketReply_authorIdToReply")
  accounts                       Account[]
  sessions                       Session[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Ticket {
  id                           String         @id @default(uuid())
  ticketNumber                 Int            @unique @default(autoincrement())
  title                        String
  description                  String?
  senderName                   String
  senderEmail                  String
  status                       TicketStatus   @default(OPEN)
  priority                     TicketPriority @default(MEDIUM)
  category                     TicketCategory?
  assigneeId                   String?
  reporterId                   String?
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt
  resolvedAt                   DateTime?
  resolvedByAI                 Boolean        @default(false)
  user_Ticket_assigneeIdTouser User?          @relation("Ticket_assigneeIdTouser", fields: [assigneeId], references: [id])
  user_Ticket_reporterIdTouser User?          @relation("Ticket_reporterIdTouser", fields: [reporterId], references: [id])
  replies                      Reply[]        @relation("TicketReplies")
  emailMessages                EmailMessage[] @relation("TicketEmailMessages")

  @@index([assigneeId])
  @@index([priority])
  @@index([reporterId])
  @@index([status])
  @@index([resolvedByAI])
  @@index([resolvedAt])
  @@map("Ticket")
}

enum SenderType {
  AGENT
  CUSTOMER
}

/// Whether an EmailMessage row was recorded from an inbound (received) email
/// or an outbound (sent) email.
enum EmailDirection {
  INBOUND
  OUTBOUND
}

/// Delivery lifecycle for outbound emails. Inbound rows have no delivery
/// status (null).
enum EmailDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

model Reply {
  id        String   @id @default(uuid())
  body      String
  ticketId  String
  ticket    Ticket   @relation("TicketReplies", fields: [ticketId], references: [id])
  authorId  String
  author    User     @relation("TicketReply_authorIdToReply", fields: [authorId], references: [id])
  senderType SenderType @default(AGENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  emailMessages EmailMessage[] @relation("ReplyEmailMessages")

  @@index([ticketId])
  @@index([authorId])
  @@map("Reply")
}

/// Stores threading/dedup metadata for inbound emails processed by the
/// email service. One row per processed email Message-ID.
model EmailMessage {
  id            String   @id @default(uuid())
  /// RFC 5322 Message-ID of the incoming email, or the Resend email ID /
  /// pending marker for outbound emails (unique = duplicate prevention).
  /// Outbound rows do NOT contain an RFC Message-ID: the Resend send API only
  /// returns its own opaque email id.
  messageId     String   @unique
  /// RFC 5322 In-Reply-To header (raw)
  inReplyTo     String?
  /// RFC 5322 References header (raw)
  references    String?
  /// Gmail thread ID (X-GM-THRID), when reliably available
  gmailThreadId String?
  createdAt     DateTime @default(now())

  /// Direction of the email. Defaults to INBOUND so all pre-existing rows
  /// (which were inbound-only) keep their semantics.
  direction     EmailDirection @default(INBOUND)
  /// Delivery status for OUTBOUND emails. Null for INBOUND emails.
  deliveryStatus EmailDeliveryStatus?
  /// Last error message when an outbound send failed.
  lastError     String?
  /// Number of send attempts made for this outbound email.
  retryCount    Int    @default(0)

  ticketId String
  ticket   Ticket  @relation("TicketEmailMessages", fields: [ticketId], references: [id])
  replyId  String?
  reply    Reply?  @relation("ReplyEmailMessages", fields: [replyId], references: [id])

  @@index([inReplyTo])
  @@index([gmailThreadId])
  @@index([ticketId])
  @@index([direction, deliveryStatus])
  @@map("EmailMessage")
}

enum Role {
  USER
  ADMIN
  AGENT
}

enum TicketStatus {
  NEW
  PROCESSING
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  GENERAL_QUESTION
  TECHNICAL_QUESTION
  REFUND_REQUEST
}
